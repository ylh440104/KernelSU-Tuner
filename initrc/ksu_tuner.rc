service ksu_tuner_boot /system/bin/sh /data/adb/modules/ksu_tuner/bin/init-apply.sh
    class late_start
    user root
    group root
    oneshot
    seclabel u:r:ksu:s0

service ksu_tuner_watch /system/bin/sh /data/adb/modules/ksu_tuner/bin/appwatch.sh run
    class late_start
    user root
    group root
    disabled
    seclabel u:r:ksu:s0

on property:sys.boot_completed=1
    start ksu_tuner_watch